# ══════════════════════════════════════════════════════════
#  CyberGuardian AI — Modèle de configuration locale
#  Copier ce fichier vers .env.local :
#    cp .env.example .env.local
# ══════════════════════════════════════════════════════════

ENV=local

# ── Kafka / Redpanda (Local Host) ─────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
KAFKA_TOPIC_SIM_EVENTS=sim-events
KAFKA_TOPIC_TRANSACTIONS=transactions
KAFKA_TOPIC_OTP_EVENTS=otp-events

# ── Redis (Feature Store Local) ───────────────────────────
REDIS_HOST=localhost
REDIS_PORT=16379

# ── PostgreSQL (Base relationnelle locale) ────────────────
POSTGRES_DSN=postgresql://cyberguardian:cyberguardian_dev@localhost:15432/cyberguardian

# ── MinIO (S3 Local) ──────────────────────────────────────
MINIO_ENDPOINT=localhost:19000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET_DATASETS=cg-datasets
MINIO_BUCKET_MODELS=cg-models
MINIO_BUCKET_REPORTS=cg-reports

# ── Scoring ───────────────────────────────────────────────
SCORE_THRESHOLD_LOW=30
SCORE_THRESHOLD_MED=70
SCORE_THRESHOLD_HIGH=90
RULES_PATH=engine/rules/rules.yaml
RULES_BUCKET=cg-models
RULES_S3_KEY=rules/rules.yaml

# ── Simulateur ────────────────────────────────────────────
SIM_NB_ABONNES=500
SIM_SEED=42
SIM_DUREE_JOURS=30
SIM_DATE_DEBUT=2026-07-01
SIM_TAUX_FRAUDE=0.20
SIM_MODE=batch
